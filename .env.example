# 이 파일을 .env 로 복사해서 값을 채우세요.

# ── 필수 ────────────────────────────────────────────────────────────────
# MySQL / MariaDB 접속 문자열
# 로컬 Docker 예시: mysql://root:reqflow@localhost:3307/reqflow
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# ── 서버 ────────────────────────────────────────────────────────────────
# API + 정적 파일을 서빙할 포트 (Railway/Render 는 PORT 를 자동 주입합니다)
PORT=3001

# production 이면 Express 가 dist/ 를 함께 서빙하고 CORS 를 닫습니다.
NODE_ENV=development

# ── 접근 제한 ───────────────────────────────────────────────────────────
# 둘 다 설정하면 /api/health 를 제외한 전체 요청에 Basic Auth 가 걸립니다.
# 공개 URL 로 배포한다면 반드시 채우세요 (앱 자체에는 로그인 기능이 없습니다).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# 프론트를 다른 도메인에 따로 배포할 때만 사용합니다 (쉼표 구분).
# 단일 호스트 배포라면 비워두세요 — same-origin 이라 CORS 가 필요 없습니다.
CORS_ORIGINS=
